rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App 1: Gia đình
    match /families/{familyId}/{document=**} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }
    match /families/{familyId}/members/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // App 2: Khu phố
    match /neighborhoods/{nbId} {
      // ✅ Cho phép query tìm bằng joinCode (chưa cần là thành viên)
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/neighborhoods/$(nbId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    match /neighborhoods/{nbId}/{document=**} {
      // ✅ Đọc: phải là thành viên
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/neighborhoods/$(nbId)/members/$(request.auth.uid));
      // ✅ Ghi: admin hoặc member
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/neighborhoods/$(nbId)/members/$(request.auth.uid)).data.role in ['admin', 'member'];
    }
    match /neighborhoods/{nbId}/members/{userId} {
      // ✅ Tự ghi thông tin mình khi tham gia lần đầu
      allow write: if request.auth != null
        && (request.auth.uid == userId
          || get(/databases/$(database)/documents/neighborhoods/$(nbId)/members/$(request.auth.uid)).data.role == 'admin');
    }

    // User memberships
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Proposals collection
		match /neighborhoods/{nbId}/proposals/{docId} {
  		allow read: if request.auth != null
    	&& exists(/databases/$(database)/documents/neighborhoods/$(nbId)/members/$(request.auth.uid));
  		allow create: if request.auth != null
    	&& get(/databases/$(database)/documents/neighborhoods/$(nbId)/members/$(request.auth.uid)).data.role in ['admin', 'member'];
  		allow update, delete: if request.auth != null
    	&& get(/databases/$(database)/documents/neighborhoods/$(nbId)/members/$(request.auth.uid)).data.role == 'admin';
		}

  }
}